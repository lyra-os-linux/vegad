[
  "qemu-system-x86_64",
  "-name",
  "lyra-parental-root-btrfs-test",
  "-machine",
  "q35",
  "-accel",
  "kvm",
  "-cpu",
  "host",
  "-smp",
  "2",
  "-m",
  "3072",
  "-kernel",
  "/usr/lib/modules/6.12.0-160100.4-default/vmlinuz",
  "-initrd",
  "/tmp/lyra-parental-layout-20261006/initrd-btrfs.gz",
  "-append",
  "rdinit=/init-btrfs root=/dev/vda rw console=tty0 console=ttyS0 panic=1 lyra.virtualization-test=1 lyra.parental-selinux-test=1 lyra.parental-identity-test=1 enforcing=0",
  "-drive",
  "file=/tmp/lyra-parental-layout-20261006/root-btrfs.qcow2,format=qcow2,if=none,id=root",
  "-device",
  "virtio-blk-pci,drive=root,serial=lyra-parental-root-t",
  "-drive",
  "file=/tmp/lyra-parental-layout-20261006/domain.qcow2,format=qcow2,if=none,id=domain",
  "-device",
  "virtio-blk-pci,drive=domain,serial=lyra-ref-domain-test",
  "-device",
  "virtio-vga",
  "-device",
  "virtio-keyboard-pci",
  "-device",
  "virtio-tablet-pci",
  "-device",
  "virtio-serial-pci",
  "-chardev",
  "socket,id=agent,path=/tmp/lyra-parental-layout-20261006/virtualization-root-btrfs/agent.sock,server=on,wait=off",
  "-device",
  "virtserialport,chardev=agent,name=org.lyra.vmtest",
  "-qmp",
  "unix:/tmp/lyra-parental-layout-20261006/virtualization-root-btrfs/qmp.sock,server=on,wait=off",
  "-vnc",
  "unix:/tmp/lyra-parental-layout-20261006/virtualization-root-btrfs/vnc.sock",
  "-serial",
  "file:/tmp/lyra-parental-layout-20261006/virtualization-root-btrfs-serial.log",
  "-monitor",
  "none",
  "-nic",
  "user,model=virtio-net-pci",
  "-no-reboot"
]
