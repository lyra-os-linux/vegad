<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Granular polkit actions for vegad. One action per
  privileged D-Bus method — read-only methods (Search, ListX, Status, ...)
  are intentionally not covered here, see the org.lyraos.Vega1.*.xml
  contract in https://github.com/lyra-os-linux/lyra-vega-dbus.
-->
<policyconfig>
  <vendor>Vega</vendor>
  <vendor_url>https://github.com/lyra-os-linux/vegad</vendor_url>
  <icon_name>vega</icon_name>

  <action id="org.lyraos.vega.software.install">
    <description>Instalar pacotes de software</description>
    <message>Autenticação é necessária para instalar software</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.software.remove">
    <description>Remover pacotes de software</description>
    <message>Autenticação é necessária para remover software</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.software.update">
    <description>Atualizar todos os pacotes</description>
    <message>Autenticação é necessária para atualizar o sistema</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.software.manage-repos">
    <description>Gerenciar repositórios de pacotes</description>
    <message>Autenticação é necessária para alterar repositórios</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.software.clear-cache">
    <description>Limpar cache de pacotes</description>
    <message>Autenticação é necessária para limpar o cache de pacotes</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.snapshots.create">
    <description>Criar ponto de restauração</description>
    <message>Autenticação é necessária para criar um ponto de restauração</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.snapshots.rollback">
    <description>Restaurar o sistema a partir de um ponto de restauração</description>
    <message>Autenticação é necessária para restaurar o sistema</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.snapshots.configure">
    <description>Configurar política de retenção de pontos de restauração</description>
    <message>Autenticação é necessária para alterar a política de retenção</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.snapshots.delete">
    <description>Excluir um ponto de restauração</description>
    <message>Autenticação é necessária para excluir um ponto de restauração</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.backup.configure">
    <description>Configurar backup</description>
    <message>Autenticação é necessária para configurar um backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.backup.run">
    <description>Executar backup</description>
    <message>Autenticação é necessária para executar um backup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.backup.restore">
    <description>Restaurar arquivos a partir de um backup</description>
    <message>Autenticação é necessária para restaurar arquivos</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.kernel.switch">
    <description>Instalar, remover ou trocar o kernel</description>
    <message>Autenticação é necessária para alterar o kernel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.users.manage">
    <description>Gerenciar contas de usuário</description>
    <message>Autenticação é necessária para gerenciar contas de usuário</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.firewall.configure">
    <description>Configurar o firewall</description>
    <message>Autenticação é necessária para configurar o firewall</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.services.configure">
    <description>Gerenciar serviços systemd</description>
    <message>Autenticação é necessária para gerenciar serviços</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.system.configure">
    <description>Configurar data, hora, idioma e teclado</description>
    <message>Autenticação é necessária para alterar configurações regionais do sistema</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.network.configure">
    <description>Configurar conexões de rede e proxy</description>
    <message>Autenticação é necessária para alterar a configuração de rede</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.bluetooth.configure">
    <description>Configurar conexões Bluetooth</description>
    <message>Autenticação é necessária para alterar conexões Bluetooth</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.bluetooth.transfer">
    <description>Transferir arquivos por Bluetooth</description>
    <message>Autenticação é necessária para transferir arquivos por Bluetooth</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.storage.mount">
    <description>Montar ou desmontar volumes</description>
    <message>Autenticação é necessária para montar ou desmontar armazenamento</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.storage.read-admin">
    <description>Measure the space the system can free</description>
    <description xml:lang="pt_BR">Medir o espaço que o sistema pode liberar</description>
    <description xml:lang="es">Medir el espacio que el sistema puede liberar</description>
    <message>Access to storage information is not allowed for this session</message>
    <message xml:lang="pt_BR">Esta sessão não tem acesso às informações de armazenamento</message>
    <message xml:lang="es">Esta sesión no tiene acceso a la información de almacenamiento</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.lyraos.vega.storage.cleanup">
    <description>Free disk space</description>
    <description xml:lang="pt_BR">Liberar espaço em disco</description>
    <description xml:lang="es">Liberar espacio en disco</description>
    <message>Authentication is required to remove core dumps, old logs, caches, unused runtimes or old kernels</message>
    <message xml:lang="pt_BR">É necessário autenticar para apagar core dumps, logs antigos, caches, runtimes sem uso ou kernels antigos</message>
    <message xml:lang="es">Es necesario autenticarse para borrar volcados de memoria, registros antiguos, cachés, runtimes sin uso o kernels antiguos</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.monitor.kill">
    <description>Encerrar processos</description>
    <message>Autenticação é necessária para encerrar processos do sistema</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.logs.read-admin">
    <description>Consultar logs administrativos do sistema</description>
    <message>Autenticação é necessária para consultar logs administrativos</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.lyraos.vega.hardware.diagnose">
    <description>Run system health diagnostics</description>
    <description xml:lang="pt_BR">Executar o diagnóstico de saúde do sistema</description>
    <description xml:lang="es">Ejecutar el diagnóstico de salud del sistema</description>
    <message>Authentication is required to run health tests on disks, memory and processor</message>
    <message xml:lang="pt_BR">É necessário autenticar para executar testes de saúde no disco, na memória e no processador</message>
    <message xml:lang="es">Es necesario autenticarse para ejecutar pruebas de salud en discos, memoria y procesador</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.network.diagnose">
    <description>Check why the internet connection does not work</description>
    <description xml:lang="pt_BR">Verificar por que a conexão com a internet não funciona</description>
    <description xml:lang="es">Comprobar por qué la conexión a internet no funciona</description>
    <message>Checking the network is not allowed for this session</message>
    <message xml:lang="pt_BR">Esta sessão não pode verificar a rede</message>
    <message xml:lang="es">Esta sesión no puede comprobar la red</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.lyraos.vega.hardware.repair">
    <description>Repair problems found by the health diagnostics</description>
    <description xml:lang="pt_BR">Corrigir problemas encontrados pelo diagnóstico de saúde</description>
    <description xml:lang="es">Corregir problemas encontrados por el diagnóstico de salud</description>
    <message>Authentication is required to reinstall packages, restart services or change the clock settings</message>
    <message xml:lang="pt_BR">É necessário autenticar para reinstalar pacotes, reiniciar serviços ou alterar o relógio</message>
    <message xml:lang="es">Es necesario autenticarse para reinstalar paquetes, reiniciar servicios o cambiar el reloj</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.lyraos.vega.snapshots.read-admin">
    <description>Read protected system snapshots</description>
    <description xml:lang="pt_BR">Ler snapshots protegidos do sistema</description>
    <description xml:lang="es">Leer instantáneas protegidas del sistema</description>
    <message>Authentication is required to read protected system data</message>
    <message xml:lang="pt_BR">É necessário autenticar para ler dados protegidos do sistema</message>
    <message xml:lang="es">Es necesario autenticarse para leer datos protegidos del sistema</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.lyraos.vega.backup.read-admin">
    <description>Read administrative backup configuration and archives</description>
    <description xml:lang="pt_BR">Ler configurações e arquivos de backups administrativos</description>
    <description xml:lang="es">Leer configuraciones y archivos de copias administrativas</description>
    <message>Authentication is required to read protected system data</message>
    <message xml:lang="pt_BR">É necessário autenticar para ler dados protegidos do sistema</message>
    <message xml:lang="es">Es necesario autenticarse para leer datos protegidos del sistema</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.lyraos.vega.kernel.read-admin">
    <description>Read protected boot entries</description>
    <description xml:lang="pt_BR">Ler entradas de boot protegidas</description>
    <description xml:lang="es">Leer entradas de arranque protegidas</description>
    <message>Authentication is required to read protected system data</message>
    <message xml:lang="pt_BR">É necessário autenticar para ler dados protegidos do sistema</message>
    <message xml:lang="es">Es necesario autenticarse para leer datos protegidos del sistema</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
  <action id="org.lyraos.vega.firewall.read-admin">
    <description>Read firewall services and ports</description>
    <description xml:lang="pt_BR">Consultar serviços e portas do firewall</description>
    <description xml:lang="es">Consultar servicios y puertos del cortafuegos</description>
    <message>Access to firewall information is not allowed for this session</message>
    <message xml:lang="pt_BR">Esta sessão não tem acesso às informações do firewall</message>
    <message xml:lang="es">Esta sesión no tiene acceso a la información del cortafuegos</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
</policyconfig>
