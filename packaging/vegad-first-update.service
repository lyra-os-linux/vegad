[Unit]
Description=Vega first-boot repository preparation
Documentation=https://lyraos.com.br/vega
# Runs once per installed system: the marker is written only after keys,
# refresh and publication of pending updates succeed. Never in the live ISO session.
ConditionPathExists=!/var/lib/vega/first-update.done
ConditionPathExists=!/var/lib/vega/first-update.skipped
ConditionKernelCommandLine=!rd.live.image
# Only the Lyra OS Desktop image ships this file. Installing vegad on an
# existing openSUSE Leap must not trigger repository preparation.
ConditionPathExists=/usr/lib/lyra-os/release
Wants=network-online.target
After=network-online.target time-sync.target
# A failure (typically no network yet) is retried below; after five tries in
# three hours it waits for the next boot instead of looping.
StartLimitIntervalSec=3h
StartLimitBurst=5

[Service]
# exec, not oneshot: multi-user.target must not wait for repository preparation, so
# the user can log in while it runs.
Type=exec
EnvironmentFile=-/etc/vega/vegad.conf
# Wait for a Zypper lock held by Vega or another tool instead of failing.
Environment=ZYPP_LOCK_TIMEOUT=600
ExecStart=/usr/lib/vega/vegad first-update
Restart=on-failure
RestartSec=15min
# Upper bound for stopping the repository preparation processes.
TimeoutStopSec=15min
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20

# Imports signing keys into the RPM database and writes repository metadata.
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
