# Installed together with the matching-version lyra-nvidia dependency contract.
# Do not enable this source without a qualified driver/KMP integration profile.
[lyra-nvidia-upstream]
name=NVIDIA official SUSE 16 - managed by Lyra NVIDIA integration
enabled=1
autorefresh=1
baseurl=https://developer.download.nvidia.com/compute/cuda/repos/suse16/x86_64/
type=rpm-md
gpgcheck=1
repo_gpgcheck=1
pkg_gpgcheck=1
gpgkey=https://developer.download.nvidia.com/compute/cuda/repos/suse16/x86_64/3A8B5622.pub
