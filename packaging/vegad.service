[Unit]
Description=Vega privileged system daemon
Documentation=https://lyraos.com.br/vega

[Service]
Type=dbus
BusName=org.lyraos.Vega1
ExecStart=/usr/lib/vega/vegad
User=root
EnvironmentFile=-/etc/vega/vegad.conf

# vegad administra pacotes, usuários, rede, mounts, backups e boot. Por isso
# ProtectSystem/ProtectHome, CapabilityBoundingSet e filtros agressivos de
# syscalls seriam incompatíveis com sua função. As barreiras abaixo reduzem
# superfície sem impedir os subprocessos administrativos autorizados.
# The daemon invokes /usr/sbin/runuser for per-user Flatpak operations.
# NoNewPrivileges would prevent that uid transition even though the target
# account is resolved and selected by vegad's polkit-authorized request.
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

# Bus-activated: systemd starts this
# unit on demand when a client calls org.lyraos.Vega1, and vegad exits on
# its own idle timeout (see vegad/internal/dbusserver.IdleTimeout). There is
# deliberately no [Install] section — this unit is not meant to be
# `systemctl enable`d, only present so bus activation can find it.
